{
  "experiment": {
    "type": "ood",
    "seed": 7,
    "output_dir": "runs/ood_faithful"
  },
  "dataset": {
    "name": "faithful",
    "path": "data/raw/faithful.csv",
    "target": "eruptions",
    "features": [
      "waiting"
    ],
    "split": {
      "strategy": "by_threshold_band",
      "params": {
        "low": 63,
        "high": 72
      }
    },
    "standardize": true
  },
  "pseudo_ground_truth": {
    "name": "gmm",
    "params": {
      "n_components": 2
    }
  },
  "model": {
    "name": "ensemble",
    "params": {
      "base_model": "mdn",
      "base_params": {
        "hidden_sizes": [
          64,
          64
        ],
        "num_components": 5,
        "epochs": 5
      },
      "n_members": 5,
      "bootstrap": true,
      "marginalization": {
        "predict": "bma_expected",
        "approximate": "point_estimate",
        "point_estimate_criterion": "mle"
      }
    }
  },
  "uncertainty": {
    "measures": [
      {
        "name": "variance",
        "params": {
          "decomposition": "epistemic"
        }
      },
      {
        "name": "variance",
        "params": {
          "decomposition": "aleatoric"
        }
      }
    ]
  },
  "correlation": {
    "enabled": true,
    "method": [
      "pearson",
      "spearman"
    ],
    "output_dir": "runs/_correlation"
  },
  "metrics": {
    "primary": [
      "moae",
      "mose"
    ],
    "ood": [
      "auroc",
      "auprc"
    ]
  }
}