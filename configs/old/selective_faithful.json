{
  "experiment": {
    "type": "selective",
    "seed": 42,
    "output_dir": "runs/selective_faithful"
  },
  "dataset": {
    "name": "faithful",
    "path": "data/raw/faithful.csv",
    "target": "waiting",
    "features": [
      "duration"
    ],
    "split": {
      "strategy": "random",
      "params": {
        "train": 0.6,
        "val": 0.2
      }
    },
    "standardize": true
  },
  "pseudo_ground_truth": {
    "name": "conditional_kde",
    "params": {
      "bandwidth": 0.5
    }
  },
  "model": {
    "name": "bnn_vi",
    "params": {
      "hidden_dims": [64, 64],
      "n_components": 2,
      "prior_sigma": 1.0,
      "n_mc_samples": 20,
      "n_epochs": 200,
      "batch_size": 32,
      "marginalization": {
      "predict": "bma_expected",         
      "approximate": "point_estimate",   
      "point_estimate_criterion": "mean" 
      }
    }
  },
  "uncertainty": {
  "measures": [
    { "name": "differential_entropy", "params": { "decomposition": "total",     "label": "differential_entropy_total" } },
    { "name": "quest", "params": { "decomposition": "total",     "label": "quest_total_10%" , "alpha":0.32} },
    { "name": "variance", "params": { "decomposition": "total",     "label": "variance_total" } }
  ]
},
  "correlation": {
    "enabled": true,
    "method": [
      "pearson",
      "spearman"
    ],
    "output_dir": "runs/_correlation"
  },
  "metrics": {
    "primary": [
      "moae",
      "mose"
    ],
    "distributional": [
      "nll",
      "crps"
    ]
  }
}