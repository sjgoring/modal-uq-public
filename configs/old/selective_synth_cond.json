{
  "experiment": {
    "type": "selective",
    "seed": 42,
    "output_dir": "runs/selective_synth_cond",
    "needs_psuedo_ground_truth": false
  },
  "dataset": {
    "name": "synthetic_conditional",
    "params":{
      "n_samples": 50000,
      "n_modes": 2,
      "n_features": 1,
      "seed_master": 42
      }
    } 
  ,
  "pseudo_ground_truth": {
    "name": "conditional_kde",
    "params": {
      "bandwidth": 0.5
    }
  }
  ,
  "model": {
    "name": "mdn",
  "params": {
      "n_gaussians": 2,
      "weight_decay": 1e-2,
      "epochs": 1000
  },
    "inferential_choice": {
      "predict": "bma_expected",         
      "approximate": "point_estimate",   
      "point_estimate_criterion": "mle" 
      }
  },
  "uncertainty": {
  "measures": [
    { "name": "differential_entropy", "params": { "decomposition": "total",     "label": "differential_entropy_total" } },
    { "name": "differential_entropy", "params": { "decomposition": "aleatoric",     "label": "differential_aleatoric_total" } },
    { "name": "alpha_volume", "params": { "decomposition": "total",     "label": "alpha_volume_total_32%" , "alpha":0.32} },
    { "name": "alpha_volume", "params": { "decomposition": "aleatoric",     "label": "alpha_volume_aleatoric_32%" , "alpha":0.32} },
    { "name": "variance", "params": { "decomposition": "total",     "label": "variance_total" } },
    { "name": "variance", "params": { "decomposition": "aleatoric",     "label": "variance_aleatoric" } }
  ]
},
  "correlation": {
    "enabled": true,
    "method": [
      "pearson",
      "spearman"
    ],
    "output_dir": "runs/_correlation/26-03-24-s"
  },
  "metrics": {
    "primary": [
      "moae"    
    ],
    "distributional": [
      "nll",
      "crps"
    ]
  }
}
