{
  "experiment": {
    "type": "active_learning",
    "seed": 13,
    "output_dir": "runs/al_forestfires",
    "al": {
      "init_size": 40,
      "batch": 10,
      "rounds": 3,
      "acquisition": "variance"
    }
  },
  "dataset": {
    "name": "forestfires",
    "path": "data/raw/forestfires.csv",
    "target": "area",
    "features": [
      "temp",
      "RH",
      "wind",
      "rain",
      "FFMC",
      "DMC",
      "DC",
      "ISI",
      "X",
      "Y"
    ],
    "split": {
      "strategy": "random",
      "params": {
        "train": 0.6,
        "val": 0.2
      }
    },
    "standardize": true
  },
  "pseudo_ground_truth": {
    "name": "gmm",
    "params": {
      "n_components": 3
    }
  },
  "model": {
    "name": "mdn_mc_dropout",
    "params": {
      "hidden_sizes": [
        128,
        128
      ],
      "num_components": 5,
      "dropout_p": 0.1,
      "epochs": 3,
      "marginalization": {
        "predict": "bma_expected",
        "approximate": "point_estimate",
        "point_estimate_criterion": "mle"
      }
    }
  },
  "uncertainty": {
    "measures": [
      {
        "name": "variance",
        "params": {
          "decomposition": "total"
        }
      },
      {
        "name": "variance",
        "params": {
          "decomposition": "epistemic"
        }
      },
      {
        "name": "differential_entropy",
        "params": {
          "grid_points": 128
        }
      }
    ]
  },
  "correlation": {
    "enabled": true,
    "method": [
      "pearson",
      "spearman"
    ],
    "output_dir": "runs/_correlation"
  },
  "metrics": {
    "primary": [
      "moae",
      "mose"
    ],
    "distributional": [
      "nll",
      "crps"
    ]
  }
}