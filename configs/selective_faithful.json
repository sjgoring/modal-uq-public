{
  "experiment": {
    "type": "selective",
    "seed": 42,
    "output_dir": "runs/selective_faithful"
  },
  "dataset": {
    "name": "faithful",
    "path": "data/raw/faithful.csv",
    "target": "waiting",
    "features": [
      "eruptions"
    ],
    "split": {
      "strategy": "random",
      "params": {
        "train": 0.6,
        "val": 0.2
      }
    },
    "standardize": true
  },
  "pseudo_ground_truth": {
    "name": "conditional_kde",
    "params": {
      "bandwidth": 0.5
    }
  },
  "model": {
    "name": "mdn_mc_dropout",
    "params": {
      "hidden_sizes": [
        64,
        64
      ],
      "num_components": 5,
      "dropout_p": 0.1,
      "epochs": 5
    }
  },
  "uncertainty": {
    "measures": [
      {
        "name": "variance",
        "params": {
          "decomposition": "total"
        }
      },
      {
        "name": "variance",
        "params": {
          "decomposition": "aleatoric"
        }
      },
      {
        "name": "variance",
        "params": {
          "decomposition": "epistemic"
        }
      }
    ]
  },
  "correlation": {
    "enabled": true,
    "method": [
      "pearson",
      "spearman"
    ],
    "output_dir": "runs/_correlation"
  },
  "metrics": {
    "primary": [
      "moae",
      "mose"
    ],
    "distributional": [
      "nll",
      "crps"
    ]
  }
}