{
    "seeds": {
    "experiment": null,
    "dataset": null,
    "model": null,
    "pgt": null,
    "uncertainty": null
  },
  "experiment": {
    "type": "active_learning",
    "output_dir": "runs/active/synth_const_var_test",
    "needs_psuedo_ground_truth": false
  },
  "dataset": {
    "name": "synthetic_constant_var",
    "params":{
        "n_samples" : 100
      }
    } 
  ,
  "pseudo_ground_truth": {
    "name": "conditional_kde",
    "params": {
      "bandwidth": 0.5
    }
  }
  ,
  "model": {
    "name": "ensemble",
  "params": {
    "base_model" : "condgmm",
          "n_members" : 6,
          "base_params": {
            "n_components": 2
      }
  },
    "inferential_choice": {
      "predict": "bma",         
      "approximate": "posterior_predictive",   
      "point_estimate_criterion": "mle" 
      }
  },
  "uncertainty": {
      "measures": [
    {"name": "random", "params": { "label": "random" } },
    { "name": "differential_entropy", "params": { "decomposition": "total",     "label": "differential_entropy_total" } },
    { "name": "differential_entropy", "params": { "decomposition": "aleatoric",     "label": "differential_entropy_aleatoric" } },
    { "name": "differential_entropy", "params": { "decomposition": "epistemic",     "label": "differential_entropy_epistemic" } },
    { "name": "variance", "params": { "decomposition": "total",     "label": "variance_total" } },
    { "name": "variance", "params": { "decomposition": "aleatoric",     "label": "variance_aleatoric" } },
    { "name": "variance", "params": { "decomposition": "epistemic",     "label": "variance_epistemic" } },
    { "name": "alpha_volume", "params": { "decomposition": "total",     "label": "alpha_volume_total_5%", "alpha": 0.05 } },
    { "name": "alpha_volume", "params": { "decomposition": "aleatoric",     "label": "alpha_volume_aleatoric_5%", "alpha": 0.05 } },
    { "name": "alpha_volume", "params": { "decomposition": "epistemic",     "label": "alpha_volume_epistemic_5%", "alpha": 0.05 } },
    { "name": "integrated_volume", "params": { "decomposition": "total", "scope": "global",     "label": "integrated_volume_total", "mc_n_samples": 100, "n_alpha":10  } },
    { "name": "integrated_volume", "params": { "decomposition": "aleatoric", "scope": "global",     "label": "integrated_volume_aleatoric", "mc_n_samples": 100, "n_alpha":10  } },
    { "name": "integrated_volume", "params": { "decomposition": "epistemic", "scope": "global",     "label": "integrated_volume_epistemic", "mc_n_samples": 100, "n_alpha":10 } }
  ]
},
  "correlation": {
    "enabled": false,
    "method": [
      "pearson",
      "spearman"
    ],
    "output_dir": "runs/_correlation"
  },
  "metrics": {
    "primary": [
      "lr_true",
      "lr_est"
    ],
    "distributional": [
      "nll",
      "crps"
    ]
  }
}
