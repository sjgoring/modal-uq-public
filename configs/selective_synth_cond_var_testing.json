{
  "experiment": {
    "type": "selective",
    "seed": 42,
    "output_dir": "runs/selective_synth_cond_var",
    "needs_psuedo_ground_truth": false
  },
  "dataset": {
    "name": "synthetic_constant_var",
    "params":{
        "n_samples" : 1000
      }
    } 
  ,
  "pseudo_ground_truth": {
    "name": "conditional_kde",
    "params": {
      "bandwidth": 0.5
    }
  }
  ,
  "model": {
    "name": "ensemble",
  "params": {
    "base_model" : "condgmm",
          "n_members" : 2
  },
    "inferential_choice": {
      "predict": "posterior_predictive",         
      "approximate": "point_estimate",   
      "point_estimate_criterion": "mle" 
      }
  },
  "uncertainty": {
  "measures": [
    { "name": "alpha_volume", "params": { "decomposition": "total",     "label": "alpha_volume_total_32%" , "alpha":0.32, "mc_n_samples":100} }
  ]
},
  "correlation": {
    "enabled": true,
    "method": [
      "pearson",
      "spearman"
    ],
    "output_dir": "runs/_correlation"
  },
  "metrics": {
    "primary": [
      "lr_true",
      "coverage_est"
    ],
    "distributional": [
      "nll",
      "crps"
    ]
  }
}
